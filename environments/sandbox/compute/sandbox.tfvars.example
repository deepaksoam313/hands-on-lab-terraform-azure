# Copy to sandbox.tfvars, fill in real values, do NOT commit.

org           = "acme"
app           = "platform"
region        = "us-east-1"

# From your existing VPC (or run the networking component first):
vpc_id    = "vpc-0abc12345678"
subnet_id = "subnet-0abc12345678"

instance_type = "t3.micro"
bucket_suffix = "1234"    # last-4 of your AWS account ID
